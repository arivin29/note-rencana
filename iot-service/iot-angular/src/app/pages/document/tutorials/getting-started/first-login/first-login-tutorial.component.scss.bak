// Import base tutorial styles
@import '../login/login-tutorial.component.scss';

// Additional styles specific to First Login Tutorial

.welcome-card {
  background: linear-gradient(135deg, rgba(33, 150, 243, 0.1) 0%, rgba(156, 39, 176, 0.1) 100%);
  border: 1px solid rgba(33, 150, 243, 0.3);
  border-radius: 12px;
  padding: 32px;
  text-align: center;
  margin: 24px 0;

  .welcome-icon {
    margin-bottom: 20px;
  }

  h4 {
    color: rgba(255,255,255,0.9);
    margin-bottom: 12px;
  }

  p {
    color: rgba(255,255,255,0.7);
    margin-bottom: 24px;
  }

  .setup-checklist {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-top: 24px;

    .checklist-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      background: rgba(255,255,255,0.05);
      border-radius: 8px;
      text-align: left;

      i {
        font-size: 20px;
      }

      span {
        color: rgba(255,255,255,0.8);
        font-size: 14px;
      }
    }
  }
}

.password-requirements-box {
  background: rgba(255, 152, 0, 0.05);
  border: 1px solid rgba(255, 152, 0, 0.2);
  border-radius: 8px;
  padding: 24px;
  margin: 24px 0;

  h4 {
    color: #ffb74d;
    margin-bottom: 20px;
  }

  .requirements-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 12px;

    .requirement-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px;
      background: rgba(255,255,255,0.03);
      border-radius: 6px;

      i {
        font-size: 18px;
        flex-shrink: 0;
      }

      span {
        color: rgba(255,255,255,0.7);
        font-size: 14px;
      }
    }
  }
}

.password-strength {
  .strength-bar {
    height: 4px;
    border-radius: 2px;
    transition: all 0.3s;

    &.strength-weak {
      width: 33%;
      background: #f44336;
    }

    &.strength-medium {
      width: 66%;
      background: #ff9800;
    }

    &.strength-strong {
      width: 100%;
      background: #4caf50;
    }
  }
}

.profile-form-demo {
  .profile-section {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    padding: 24px;
    margin-bottom: 20px;

    h4 {
      margin-bottom: 20px;
      display: flex;
      align-items: center;
    }
  }
}

.profile-picture-upload {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;

  .upload-area {
    background: rgba(255,255,255,0.03);
    border: 2px dashed rgba(255,255,255,0.2);
    border-radius: 8px;
    padding: 40px 20px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s;

    &:hover {
      background: rgba(255,255,255,0.05);
      border-color: var(--bs-primary);
    }

    i {
      display: block;
      margin-bottom: 12px;
      opacity: 0.5;
    }

    p {
      color: rgba(255,255,255,0.8);
    }
  }

  .upload-tips {
    h6 {
      color: rgba(255,255,255,0.8);
      margin-bottom: 12px;
    }

    ul {
      margin: 0;
      padding-left: 20px;
      color: rgba(255,255,255,0.6);

      li {
        margin-bottom: 6px;
        font-size: 14px;
      }
    }
  }
}

.notification-settings {
  .notification-group {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    padding: 24px;

    .notification-header {
      display: flex;
      align-items: start;
      margin-bottom: 20px;
      padding-bottom: 16px;
      border-bottom: 1px solid rgba(255,255,255,0.1);

      h4 {
        margin: 0 0 4px 0;
        color: rgba(255,255,255,0.9);
      }

      p {
        margin: 0;
      }
    }

    .notification-options {
      .form-check {
        padding: 16px;
        border-radius: 6px;
        margin-bottom: 12px;
        transition: background 0.2s;

        &:hover {
          background: rgba(255,255,255,0.03);
        }

        .form-check-input {
          width: 48px;
          height: 24px;
          margin-top: 0;

          &:checked {
            background-color: var(--bs-primary);
            border-color: var(--bs-primary);
          }
        }

        .form-check-label {
          margin-left: 12px;
          
          strong {
            color: rgba(255,255,255,0.85);
            display: block;
            margin-bottom: 4px;
          }

          small {
            color: rgba(255,255,255,0.5);
          }
        }

        .badge {
          font-size: 10px;
          padding: 3px 8px;
          vertical-align: middle;
        }
      }
    }
  }
}

.terms-section {
  .terms-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    padding: 24px;

    .terms-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      padding-bottom: 16px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      flex-wrap: wrap;
      gap: 12px;

      > div {
        flex: 1;

        h4 {
          margin: 0 0 4px 0;
          color: rgba(255,255,255,0.9);
        }

        p {
          margin: 0;
        }
      }
    }

    .terms-content {
      h5 {
        color: rgba(255,255,255,0.85);
        margin-bottom: 12px;
      }

      ul {
        color: rgba(255,255,255,0.7);

        li {
          margin-bottom: 8px;
        }

        strong {
          color: rgba(255,255,255,0.85);
        }
      }

      .terms-scroll-box {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 6px;
        padding: 16px;
        margin-top: 16px;
        max-height: 300px;
        overflow-y: auto;

        h6 {
          color: rgba(255,255,255,0.8);
          margin-bottom: 12px;
        }

        .key-points {
          .point-item {
            display: flex;
            align-items: start;
            gap: 12px;
            margin-bottom: 12px;

            i {
              font-size: 18px;
              margin-top: 2px;
            }

            span {
              color: rgba(255,255,255,0.7);
              font-size: 14px;
            }
          }
        }
      }
    }

    .privacy-highlights {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 16px;
      margin-top: 16px;

      .highlight-item {
        display: flex;
        gap: 16px;
        padding: 16px;
        background: rgba(255,255,255,0.03);
        border-radius: 6px;

        i {
          font-size: 32px;
          flex-shrink: 0;
        }

        h6 {
          color: rgba(255,255,255,0.85);
          margin-bottom: 6px;
        }

        p {
          color: rgba(255,255,255,0.6);
          font-size: 14px;
          margin: 0;
        }
      }
    }
  }
}

.acceptance-box {
  background: rgba(33, 150, 243, 0.05);
  border: 1px solid rgba(33, 150, 243, 0.2);
  border-radius: 8px;
  padding: 24px;

  h5 {
    color: #64b5f6;
    margin-bottom: 20px;
  }

  .form-check {
    padding: 16px;
    background: rgba(255,255,255,0.03);
    border-radius: 6px;

    .form-check-input {
      width: 20px;
      height: 20px;
      margin-top: 2px;

      &:checked {
        background-color: var(--bs-primary);
        border-color: var(--bs-primary);
      }
    }

    .form-check-label {
      margin-left: 12px;

      strong {
        color: rgba(255,255,255,0.85);
        display: block;
        margin-bottom: 4px;
      }

      small {
        color: rgba(255,255,255,0.5);
      }
    }
  }
}

.review-summary {
  background: rgba(76, 175, 80, 0.05);
  border: 1px solid rgba(76, 175, 80, 0.2);
  border-radius: 8px;
  padding: 24px;
  margin: 24px 0;

  h4 {
    color: #81c784;
    margin-bottom: 20px;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;

    .summary-item {
      display: flex;
      gap: 16px;
      padding: 16px;
      background: rgba(255,255,255,0.03);
      border-radius: 6px;

      &.completed i {
        font-size: 24px;
      }

      h6 {
        color: rgba(255,255,255,0.85);
        margin-bottom: 4px;
      }

      p {
        margin: 0;
        font-size: 14px;
      }
    }
  }
}

.completion-action {
  padding: 32px 0;

  .btn-lg {
    padding: 16px 48px;
    font-size: 18px;
    font-weight: 600;
  }
}

.next-steps-box {
  background: rgba(33, 150, 243, 0.05);
  border-left: 4px solid #2196f3;
  border-radius: 4px;
  padding: 24px;

  h4 {
    color: #64b5f6;
    margin-bottom: 16px;
  }

  .next-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-top: 20px;

    .next-step-card {
      text-align: center;
      padding: 20px;
      background: rgba(255,255,255,0.03);
      border-radius: 8px;
      transition: all 0.3s;

      &:hover {
        background: rgba(255,255,255,0.05);
        transform: translateY(-4px);
      }

      i {
        display: block;
        margin-bottom: 12px;
      }

      h5 {
        font-size: 16px;
        color: rgba(255,255,255,0.85);
        margin-bottom: 8px;
      }

      p {
        font-size: 13px;
        color: rgba(255,255,255,0.6);
        margin: 0;
      }
    }
  }
}

.help-section {
  background: rgba(76, 175, 80, 0.05);
  border-left: 4px solid #4caf50;
  border-radius: 4px;
  padding: 20px;

  h5 {
    color: #81c784;
    margin-bottom: 16px;
  }

  .help-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;

    .help-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      background: rgba(255,255,255,0.03);
      border-radius: 6px;
      color: rgba(255,255,255,0.7);
      text-decoration: none;
      transition: all 0.2s;

      &:hover {
        background: rgba(255,255,255,0.05);
        color: rgba(255,255,255,0.9);
        transform: translateX(4px);
      }

      i {
        font-size: 20px;
        color: var(--bs-primary);
      }

      span {
        font-size: 14px;
      }
    }
  }
}

// Responsive adjustments
@media (max-width: 992px) {
  .profile-picture-upload {
    grid-template-columns: 1fr;
  }

  .privacy-highlights {
    grid-template-columns: 1fr !important;
  }
}

@media (max-width: 768px) {
  .welcome-card {
    padding: 20px;

    .setup-checklist {
      grid-template-columns: 1fr;
    }
  }

  .requirements-grid {
    grid-template-columns: 1fr !important;
  }

  .summary-grid {
    grid-template-columns: 1fr !important;
  }

  .next-steps-grid {
    grid-template-columns: 1fr !important;
  }

  .help-links {
    grid-template-columns: 1fr !important;
  }

  .terms-header {
    flex-direction: column;
  }
}
