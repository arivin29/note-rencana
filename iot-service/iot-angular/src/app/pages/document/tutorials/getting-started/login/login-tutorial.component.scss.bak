.tutorial-header {
  padding: 24px;
  background: rgba(255,255,255,0.02);
  border-radius: 8px;
  border: 1px solid rgba(255,255,255,0.1);

  h1 {
    font-size: 28px;
    font-weight: 600;
    color: rgba(255,255,255,0.9);
  }

  .badge {
    font-size: 12px;
    padding: 6px 12px;
  }
}

.tutorial-content {
  padding: 24px 0;

  .tutorial-section {
    h2 {
      font-size: 24px;
      font-weight: 600;
      color: rgba(255,255,255,0.9);
      margin-bottom: 24px;
      padding-bottom: 12px;
      border-bottom: 2px solid rgba(255,255,255,0.1);
    }

    h3 {
      font-size: 20px;
      font-weight: 500;
      color: rgba(255,255,255,0.85);
      margin: 24px 0 16px 0;
    }

    h4 {
      font-size: 18px;
      font-weight: 500;
      color: rgba(255,255,255,0.8);
      margin: 20px 0 12px 0;
    }

    h5 {
      font-size: 16px;
      font-weight: 500;
      color: rgba(255,255,255,0.75);
    }

    p {
      color: rgba(255,255,255,0.7);
      line-height: 1.7;
      margin-bottom: 16px;
    }

    .content-block {
      margin-bottom: 32px;
    }
  }
}

// Alert Boxes
.alert {
  border-radius: 6px;
  border: 1px solid;
  
  &.alert-info {
    background: rgba(33, 150, 243, 0.1);
    border-color: rgba(33, 150, 243, 0.3);
    color: #64b5f6;
  }

  &.alert-warning {
    background: rgba(255, 152, 0, 0.1);
    border-color: rgba(255, 152, 0, 0.3);
    color: #ffb74d;
  }

  &.alert-danger {
    background: rgba(244, 67, 54, 0.1);
    border-color: rgba(244, 67, 54, 0.3);
    color: #e57373;
  }

  &.alert-success {
    background: rgba(76, 175, 80, 0.1);
    border-color: rgba(76, 175, 80, 0.3);
    color: #81c784;
  }
}

// Screenshot Placeholder
.screenshot-placeholder {
  background: rgba(255,255,255,0.02);
  border: 2px dashed rgba(255,255,255,0.2);
  border-radius: 8px;
  padding: 60px 20px;
  text-align: center;
  margin: 24px 0;

  i {
    opacity: 0.3;
  }
}

// Example Box
.example-box {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  padding: 20px;
  margin: 20px 0;

  h4 {
    margin-top: 0;
    margin-bottom: 16px;
    color: rgba(255,255,255,0.8);
  }

  .form-demo {
    .form-label {
      color: rgba(255,255,255,0.7);
      font-size: 14px;
      margin-bottom: 6px;
    }

    .form-control {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.2);
      color: rgba(255,255,255,0.6);

      &:disabled {
        opacity: 0.7;
      }
    }

    .form-check-label {
      color: rgba(255,255,255,0.7);
    }
  }
}

// Tips Box
.tips-box {
  background: rgba(33, 150, 243, 0.05);
  border-left: 4px solid #2196f3;
  border-radius: 4px;
  padding: 16px 20px;
  margin: 20px 0;

  h5 {
    color: #64b5f6;
    margin-bottom: 12px;
  }

  ul {
    margin: 0;
    padding-left: 20px;
    color: rgba(255,255,255,0.7);

    li {
      margin-bottom: 6px;
    }
  }
}

// Steps List
.steps-list {
  .step-item {
    display: flex;
    gap: 16px;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255,255,255,0.05);

    &:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .step-number {
      flex-shrink: 0;
      width: 40px;
      height: 40px;
      background: var(--bs-primary);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 18px;
    }

    .step-content {
      flex: 1;

      h5 {
        margin: 0 0 8px 0;
        color: rgba(255,255,255,0.85);
      }

      p {
        margin: 0;
        color: rgba(255,255,255,0.6);
      }
    }
  }
}

// Numbered List
.numbered-list {
  counter-reset: list-counter;
  list-style: none;
  padding-left: 0;

  li {
    counter-increment: list-counter;
    position: relative;
    padding-left: 40px;
    margin-bottom: 16px;
    color: rgba(255,255,255,0.7);

    &:before {
      content: counter(list-counter);
      position: absolute;
      left: 0;
      top: 0;
      width: 28px;
      height: 28px;
      background: rgba(255,255,255,0.1);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      color: var(--bs-primary);
      font-size: 14px;
    }
  }
}

// Table
.table {
  color: rgba(255,255,255,0.7);

  thead {
    background: rgba(255,255,255,0.05);
    color: rgba(255,255,255,0.85);
  }

  tbody tr {
    border-color: rgba(255,255,255,0.1);
  }

  .badge {
    font-size: 11px;
  }
}

// Troubleshoot Grid
.troubleshoot-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
  margin: 24px 0;

  .issue-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    padding: 20px;

    .issue-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;

      i {
        font-size: 24px;
      }

      h5 {
        margin: 0;
        color: rgba(255,255,255,0.85);
      }
    }

    ul {
      margin: 0;
      padding-left: 20px;
      color: rgba(255,255,255,0.6);

      li {
        margin-bottom: 8px;
      }
    }
  }
}

// Support Box
.support-box {
  background: rgba(76, 175, 80, 0.05);
  border-left: 4px solid #4caf50;
  border-radius: 4px;
  padding: 20px;

  h5 {
    color: #81c784;
    margin-bottom: 12px;
  }

  p, ul {
    color: rgba(255,255,255,0.7);
  }

  ul {
    margin: 0;
    padding-left: 20px;
  }
}

// Tutorial Footer
.tutorial-footer {
  background: rgba(255,255,255,0.02);
  padding: 20px;
  border-radius: 8px;
  position: sticky;
  bottom: 20px;
  z-index: 10;
}

// Sections Sidebar
.sections-sidebar {
  position: fixed;
  right: 20px;
  top: 100px;
  width: 280px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  padding: 16px;
  max-height: calc(100vh - 140px);
  overflow-y: auto;

  h6 {
    color: rgba(255,255,255,0.8);
    font-weight: 600;
    margin-bottom: 12px;
  }

  .section-list {
    .section-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 12px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s;
      margin-bottom: 6px;

      &:hover {
        background: rgba(255,255,255,0.05);
      }

      &.active {
        background: rgba(var(--bs-primary-rgb), 0.2);
        border-left: 3px solid var(--bs-primary);
      }

      &.completed {
        .section-icon i {
          color: #4caf50;
        }
      }

      .section-icon {
        i {
          font-size: 18px;
          color: rgba(255,255,255,0.4);
        }
      }

      .section-title {
        font-size: 13px;
        color: rgba(255,255,255,0.7);
      }
    }
  }
}

// Responsive
@media (max-width: 1400px) {
  .sections-sidebar {
    display: none;
  }
}

@media (max-width: 768px) {
  .tutorial-header {
    padding: 16px;

    h1 {
      font-size: 22px;
    }
  }

  .tutorial-content {
    .tutorial-section h2 {
      font-size: 20px;
    }
  }

  .troubleshoot-grid {
    grid-template-columns: 1fr;
  }

  .tutorial-footer {
    position: relative;
    bottom: 0;
  }
}
